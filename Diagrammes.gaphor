<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>diagram {
  background-color: #f8f9fb;
  /* line-style: sloppy 0.3; */
}

lifeline {
  background-color: #e7ffe0;
  font-size: 16px;
  font-weight: bold;
  border-radius: 6px;
  padding: 6px 14px;
}

message {
  font-size: 16px;
  color: #1a2e5a;
  font-weight: bold;
}

message[messageSort="reply"] {
  color: #2b7553;
}

box {
  background-color: #f4e0ff;
  color: #773485;
  border-radius: 5px;
  padding: 4px 8px;
}

comment {
  background-color: #f5dbc4;
  opacity: 0.9;
}</val>
</styleSheet>
</Core:StyleSheet>
